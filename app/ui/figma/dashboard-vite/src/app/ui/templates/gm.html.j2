<!-- app/ui/templates/gm.html.j2 -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GM Dashboard - Franchise Football</title>
    <style>
        body {
            background: #0a1628;
            color: #dbe8f5;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        
        .tab {
            background: #10283c;
            border: 1px solid #224860;
            color: #dbe8f5;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
        }
        
        .tab.active {
            background: #0e6f43;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>GM Dashboard</h1>
            <p>Season {{ current_season }} - Team Management</p>
        </div>
        
        <div class="tabs">
            <a href="#" class="tab active" onclick="showTab('contracts')">Expiring Contracts</a>
            <a href="#" class="tab" onclick="showTab('staff')">Staff</a>
            <a href="#" class="tab" onclick="showTab('trade')">Trade</a>
            <a href="#" class="tab" onclick="showTab('roster')">Roster</a>
        </div>
        
        <div id="contracts-tab" class="tab-content active">
            <div class="grid">
                {% include "components/expiring_contracts.html.j2" %}
            </div>
        </div>
        
        <div id="staff-tab" class="tab-content">
            <div class="grid">
                {% include "components/staff_boxes.html.j2" %}
            </div>
        </div>
        
        <div id="trade-tab" class="tab-content">
            <div class="card">
                <div class="card-header">
                    <h3>Trade Center</h3>
                </div>
                <div class="p-3">
                    <p>Trade functionality coming soon...</p>
                </div>
            </div>
        </div>
        
        <div id="roster-tab" class="tab-content">
            <div class="card">
                <div class="card-header">
                    <h3>Roster Management</h3>
                </div>
                <div class="p-3">
                    <p>Roster management coming soon...</p>
                </div>
            </div>
        </div>
    </div>
    
    {% include "components/player_card.html.j2" %}
    
    <script>
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
        }
        
        // Initialize expiring contracts
        document.addEventListener("DOMContentLoaded", () => {
            window.initExpiringContractsBox({{ user_team_id }}, {{ current_season }});
            // Initialize staff
            window.loadStaff({{ user_team_id }});
        });
    </script>
</body>
</html>
