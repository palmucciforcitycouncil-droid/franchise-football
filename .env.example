# Environment settings for Franchise Football

# Required. The single source of truth for all simulation randomness
# (GDD Part 1 Sec 1.3). There is no fallback -- the app fails to start
# without this set.
LEAGUE_SEED=2025

# SQLite database connection
DATABASE_URL=sqlite:///franchise.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

